# ==============================================================================
# Document Pipeline & Smart Cloud Scanner - Environment Configuration
# ==============================================================================

# Server Port
PORT=3000

# ------------------------------------------------------------------------------
# Security & Authentication (JWT)
# ------------------------------------------------------------------------------
# Enable/disable authentication (recommended: true in production)
AUTH_ENABLED=true

# Standard user password for web interface access
APP_PASSWORD=ChangeThisToASecureAppPassword!

# Administrator password for settings, modular accounts & admin actions
ADMIN_PASSWORD=ChangeThisToASecureAdminPassword!

# Cryptographic secret for signing JWT session cookies (min. 32 characters)
JWT_SECRET=your_super_secret_cryptographic_jwt_key_here_min_32_chars

# ------------------------------------------------------------------------------
# Local AI Service (Ollama / LLM)
# ------------------------------------------------------------------------------
# Host URL of the local Ollama instance (default: http://localhost:11434)
LOCAL_AI_HOST=http://localhost:11434

# Model used for document extraction, metadata tagging & naming
LOCAL_AI_MODEL=gemma4:e2b

# AI processing timeout in milliseconds (default: 360000 = 6 minutes)
AI_TIMEOUT_MS=360000

# ------------------------------------------------------------------------------
# Google Cloud & Drive API
# ------------------------------------------------------------------------------
# OAuth Client ID used for Google Identity Services (GIS) & Google Drive Picker
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Zero-Trust Notice:
# Third-party credentials (Lexoffice API Keys, BuchhaltungsButler tokens,
# ClickUp API Keys, Gmail user access tokens) are stored CLIENT-SIDE in the
# browser's localStorage and are NOT configured in this .env file.
# ------------------------------------------------------------------------------
