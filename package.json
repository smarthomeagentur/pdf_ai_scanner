{
  "name": "adobe_cloud_downloader",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "node --require ./tests/setup.js --test tests/unit/*.test.js tests/integration/*.test.js tests/regression/*.test.js",
    "test:coverage": "node --require ./tests/setup.js --test --experimental-test-coverage tests/unit/*.test.js tests/integration/*.test.js tests/regression/*.test.js",
    "test:manual": "node index.js --debug --test",
    "testlocal": "node testLocalAi.js --debug",
    "lint": "eslint src/",
    "lint:check": "eslint src/ && prettier --check \"tests/**/*.js\"",
    "format": "prettier --write \"tests/**/*.js\" \"src/**/*.js\"",
    "start": "node index.js",
    "debug": "nodemon --watch . --ext js index.js --debug"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google-cloud/local-auth": "^2.1.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "exiftool-vendored": "^35.19.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "googleapis": "^105.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "ollama": "^0.6.3",
    "onnxruntime-web": "^1.20.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdf2pic": "^3.2.0",
    "sql.js": "^1.14.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  }
}
